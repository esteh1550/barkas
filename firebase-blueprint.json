{
  "entities": {
    "ConsignmentItem": {
      "title": "ConsignmentItem",
      "description": "Data pengajuan titip jual barang bekas berkualitas di info.barkasmajalengka",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode tiket unik pengajuan (contoh: #BM-2026-1234)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu pengajuan dibuat dalam format ISO string"
        },
        "fullName": {
          "type": "string",
          "description": "Nama lengkap penitip barang"
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Nomor WhatsApp aktif penitip"
        },
        "kecamatan": {
          "type": "string",
          "description": "Kecamatan domisili di Kabupaten Majalengka"
        },
        "bankAccount": {
          "type": "string",
          "description": "Nomor rekening bank atau E-Wallet untuk pencairan dana"
        },
        "category": {
          "type": "string",
          "enum": [
            "Fashion",
            "Sneakers / Sepatu",
            "Helm & Otomotif",
            "Gadget & Elektronik",
            "Lainnya"
          ],
          "description": "Kategori barang titip jual"
        },
        "itemNameAndBrand": {
          "type": "string",
          "description": "Nama barang beserta merk/brand"
        },
        "size": {
          "type": "string",
          "description": "Ukuran atau dimensi barang"
        },
        "condition": {
          "type": "string",
          "enum": [
            "Baru / BNIB",
            "Seperti Baru / Like New",
            "Bekas Pemakaian Wajar",
            "Ada Minus"
          ],
          "description": "Kondisi fisik barang"
        },
        "descriptionAndFlaws": {
          "type": "string",
          "description": "Spesifikasi lengkap, kelengkapan, dan detail minus barang"
        },
        "nettPrice": {
          "type": "number",
          "description": "Harga bersih (nett) yang diinginkan penitip dalam Rupiah"
        },
        "previousNettPrice": {
          "type": "number",
          "description": "Harga bersih (nett) sebelumnya sebelum penyesuaian turun harga (Price Drop)"
        },
        "photos": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Daftar foto barang dalam format Data URL (Base64 terkompresi)"
        },
        "agreementAccepted": {
          "type": "boolean",
          "description": "Persetujuan syarat dan ketentuan titip jual"
        },
        "status": {
          "type": "string",
          "enum": [
            "Menunggu Kurasi",
            "Diterima",
            "Ditolak",
            "Sedang Dipajang (Live)",
            "Booked (Di-DP)",
            "Terjual",
            "Selesai & Dicairkan"
          ],
          "description": "Status kurasi dan penjualan barang"
        },
        "postStatus": {
          "type": "string",
          "enum": [
            "Draft",
            "Ready to Post",
            "Posted",
            "Booked",
            "Sold Out"
          ],
          "description": "Status progres pembuatan konten postingan admin"
        },
        "syncedToGoogleForms": {
          "type": "boolean",
          "description": "Penanda apakah sudah disinkronkan ke Google Forms"
        },
        "googleFormId": {
          "type": "string",
          "description": "ID Google Form terkait"
        },
        "adminRackLocation": {
          "type": "string",
          "description": "Kode lokasi rak penyimpanan gudang internal admin"
        },
        "adminBottomNettPrice": {
          "type": "number",
          "description": "Batas harga nett paling bawah hasil kesepakatan dengan penitip"
        },
        "adminInternalNotes": {
          "type": "string",
          "description": "Catatan internal admin untuk riwayat nego dan jadwal COD"
        }
      },
      "required": [
        "id",
        "createdAt",
        "fullName",
        "whatsappNumber",
        "kecamatan",
        "bankAccount",
        "category",
        "itemNameAndBrand",
        "size",
        "condition",
        "descriptionAndFlaws",
        "nettPrice",
        "photos",
        "agreementAccepted",
        "status"
      ]
    },
    "WantedRequest": {
      "title": "WantedRequest",
      "description": "Permintaan titip cari barang oleh calon pembeli di Kabupaten Majalengka",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Kode unik permintaan cari barang (contoh: #REQ-2026-1234)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu permintaan dibuat dalam format ISO string"
        },
        "requesterName": {
          "type": "string",
          "description": "Nama pencari barang"
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Nomor WhatsApp pencari barang"
        },
        "kecamatan": {
          "type": "string",
          "description": "Kecamatan domisili pencari barang di Majalengka"
        },
        "category": {
          "type": "string",
          "enum": [
            "Fashion",
            "Sneakers / Sepatu",
            "Helm & Otomotif",
            "Gadget & Elektronik",
            "Lainnya"
          ],
          "description": "Kategori barang yang dicari"
        },
        "itemWanted": {
          "type": "string",
          "description": "Nama, merk, dan ukuran barang yang dicari"
        },
        "maxBudget": {
          "type": "number",
          "description": "Estimasi budget maksimal dalam Rupiah"
        },
        "notes": {
          "type": "string",
          "description": "Detail spesifikasi atau kondisi yang diharapkan"
        },
        "status": {
          "type": "string",
          "enum": [
            "Masih Dicari",
            "Sudah Dapat"
          ],
          "description": "Status pencarian barang"
        }
      },
      "required": [
        "id",
        "createdAt",
        "requesterName",
        "whatsappNumber",
        "kecamatan",
        "category",
        "itemWanted",
        "maxBudget",
        "notes",
        "status"
      ]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Pengaturan global aplikasi lintas perangkat (termasuk konfigurasi Webhook Auto-Post Instagram)",
      "type": "object",
      "properties": {
        "enabledOnNewSubmission": {
          "type": "boolean",
          "description": "Aktifkan auto-post saat penitip mengirim form baru"
        },
        "enabledOnAdminLive": {
          "type": "boolean",
          "description": "Aktifkan auto-post saat admin mengubah status ke Posted (Live)"
        },
        "webhookUrl": {
          "type": "string",
          "description": "URL Webhook Make.com / Zapier untuk auto-post Instagram"
        },
        "igBusinessAccountId": {
          "type": "string",
          "description": "ID Akun Instagram Bisnis opsional"
        },
        "metaAccessToken": {
          "type": "string",
          "description": "Access Token Meta Graph API opsional"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Waktu terakhir pengaturan diperbarui"
        }
      },
      "required": [
        "enabledOnNewSubmission",
        "enabledOnAdminLive",
        "webhookUrl"
      ]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/ConsignmentItem"
      },
      "description": "Koleksi data pengajuan titip jual barang secara real-time lintas perangkat"
    },
    "/wanted_requests/{requestId}": {
      "schema": {
        "$ref": "#/entities/WantedRequest"
      },
      "description": "Koleksi papan permintaan titip cari barang warga Majalengka"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/AppSettings"
      },
      "description": "Pengaturan global admin lintas perangkat (Webhook Make.com & Auto-Post IG)"
    }
  }
}
