rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: submissions
    // Document ID: {submissionId} (e.g., BM-2026-1234)
    // Fields:
    //   - id: string (required, ticket ID e.g. #BM-2026-1234)
    //   - createdAt: string (required, ISO timestamp)
    //   - fullName: string (required, 1..150 chars)
    //   - whatsappNumber: string (required, 5..30 chars)
    //   - kecamatan: string (required, 1..100 chars)
    //   - bankAccount: string (required, 1..200 chars)
    //   - category: string (required, valid ItemCategory)
    //   - itemNameAndBrand: string (required, 1..200 chars)
    //   - size: string (required, 1..100 chars)
    //   - condition: string (required, valid ItemCondition)
    //   - descriptionAndFlaws: string (required, 1..3000 chars)
    //   - nettPrice: number (required, > 0)
    //   - photos: list of strings (required, 1..8 items)
    //   - agreementAccepted: bool (required)
    //   - status: string (required, valid SubmissionStatus)
    //   - postStatus: string (optional, valid AdminPostStatus)
    //   - syncedToGoogleForms: bool (optional)
    //   - googleFormId: string (optional)
    //
    // ===============================================================

    function hasRequiredSubmissionFields(data) {
      return data.keys().hasAll([
        'id',
        'createdAt',
        'fullName',
        'whatsappNumber',
        'kecamatan',
        'bankAccount',
        'category',
        'itemNameAndBrand',
        'size',
        'condition',
        'descriptionAndFlaws',
        'nettPrice',
        'photos',
        'agreementAccepted',
        'status'
      ]);
    }

    function isValidConsignmentSubmission(data) {
      return hasRequiredSubmissionFields(data)
        && data.id is string && data.id.size() >= 3 && data.id.size() <= 50
        && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 60
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150
        && data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 35
        && data.kecamatan is string && data.kecamatan.size() >= 1 && data.kecamatan.size() <= 100
        && data.bankAccount is string && data.bankAccount.size() >= 1 && data.bankAccount.size() <= 250
        && data.category in ['Fashion', 'Sneakers / Sepatu', 'Helm & Otomotif', 'Gadget & Elektronik', 'Lainnya']
        && data.itemNameAndBrand is string && data.itemNameAndBrand.size() >= 1 && data.itemNameAndBrand.size() <= 250
        && data.size is string && data.size.size() >= 1 && data.size.size() <= 100
        && data.condition in ['Baru / BNIB', 'Seperti Baru / Like New', 'Bekas Pemakaian Wajar', 'Ada Minus']
        && data.descriptionAndFlaws is string && data.descriptionAndFlaws.size() >= 1 && data.descriptionAndFlaws.size() <= 4000
        && data.nettPrice is number && data.nettPrice > 0 && data.nettPrice <= 1000000000
        && (!('previousNettPrice' in data) || (data.previousNettPrice is number && data.previousNettPrice >= 0 && data.previousNettPrice <= 1000000000))
        && data.photos is list && data.photos.size() >= 1 && data.photos.size() <= 8
        && data.agreementAccepted is bool
        && data.status in ['Menunggu Kurasi', 'Diterima', 'Ditolak', 'Sedang Dipajang (Live)', 'Booked (Di-DP)', 'Terjual', 'Selesai & Dicairkan']
        && (!('postStatus' in data) || data.postStatus in ['Draft', 'Ready to Post', 'Posted', 'Booked', 'Sold Out'])
        && (!('syncedToGoogleForms' in data) || data.syncedToGoogleForms is bool)
        && (!('googleFormId' in data) || (data.googleFormId is string && data.googleFormId.size() <= 200))
        && (!('adminRackLocation' in data) || (data.adminRackLocation is string && data.adminRackLocation.size() <= 120))
        && (!('adminBottomNettPrice' in data) || (data.adminBottomNettPrice is number && data.adminBottomNettPrice >= 0 && data.adminBottomNettPrice <= 1000000000))
        && (!('adminInternalNotes' in data) || (data.adminInternalNotes is string && data.adminInternalNotes.size() <= 2000));
    }

    function isValidWantedRequest(data) {
      return data.keys().hasAll([
        'id',
        'createdAt',
        'requesterName',
        'whatsappNumber',
        'kecamatan',
        'category',
        'itemWanted',
        'maxBudget',
        'notes',
        'status'
      ])
      && data.id is string && data.id.size() >= 3 && data.id.size() <= 50
      && data.createdAt is string && data.createdAt.size() >= 10 && data.createdAt.size() <= 60
      && data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 150
      && data.whatsappNumber is string && data.whatsappNumber.size() >= 5 && data.whatsappNumber.size() <= 35
      && data.kecamatan is string && data.kecamatan.size() >= 1 && data.kecamatan.size() <= 100
      && data.category in ['Fashion', 'Sneakers / Sepatu', 'Helm & Otomotif', 'Gadget & Elektronik', 'Lainnya']
      && data.itemWanted is string && data.itemWanted.size() >= 2 && data.itemWanted.size() <= 250
      && data.maxBudget is number && data.maxBudget > 0 && data.maxBudget <= 1000000000
      && data.notes is string && data.notes.size() >= 1 && data.notes.size() <= 2000
      && data.status in ['Masih Dicari', 'Sudah Dapat'];
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isValidConsignmentSubmission(request.resource.data);
      allow update: if isValidConsignmentSubmission(request.resource.data);
      allow delete: if true;
    }

    match /wanted_requests/{requestId} {
      allow read: if true;
      allow create: if isValidWantedRequest(request.resource.data);
      allow update: if isValidWantedRequest(request.resource.data);
      allow delete: if true;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll([
        'enabledOnNewSubmission',
        'enabledOnAdminLive',
        'webhookUrl'
      ])
      && data.enabledOnNewSubmission is bool
      && data.enabledOnAdminLive is bool
      && data.webhookUrl is string && data.webhookUrl.size() <= 500
      && (!('igBusinessAccountId' in data) || (data.igBusinessAccountId is string && data.igBusinessAccountId.size() <= 120))
      && (!('metaAccessToken' in data) || (data.metaAccessToken is string && data.metaAccessToken.size() <= 600))
      && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidAppSettings(request.resource.data);
      allow delete: if true;
    }

    match /_connection_check/{docId} {
      allow read: if true;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
